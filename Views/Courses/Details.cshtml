@model OnlineEduPlatform.Models.Course

<h2>@Model.Name</h2>

<dl class="row">
    <dt class="col-sm-3">Учител</dt>
    <dd class="col-sm-9">@Model.Teacher?.Name</dd>

    <dt class="col-sm-3">Имейл на учителя</dt>
    <dd class="col-sm-9">@Model.Teacher?.Email</dd>

</dl>

<h3>Записани студенти</h3>

@if (Model.Students.Any())
{
    <ul>
        @foreach (var student in Model.Students)
        {
            <li>@student.Name (@student.Email)</li>
        }
    </ul>
}
else
{
    <p>Все още няма записани студенти в този курс.</p>
}
<a asp-action="Enroll" asp-route-id="@Model.Id" class="btn btn-primary">Запиши студент</a>
<a asp-action="Index" class="btn btn-secondary">Назад към списъка</a>