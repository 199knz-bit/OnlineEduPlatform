@{
    var course = ViewBag.Course as OnlineEduPlatform.Models.Course;
    var students = ViewBag.Students as List<OnlineEduPlatform.Models.Student>;
}

<h2>Запиши студент в курс: @course?.Name</h2>

<form asp-action="Enroll" method="post">
    <input type="hidden" name="id" value="@course?.Id" />
    <div class="mb-3">
        <label class="form-label">Избери студент</label>
        <select name="studentId" class="form-select" required>
            <option value="">-- Избери студент --</option>
            @foreach (var student in students)
            {
                <option value="@student.Id">@student.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Запиши</button>
    <a asp-action="Details" asp-route-id="@course?.Id" class="btn btn-secondary">Отказ</a>
</form>