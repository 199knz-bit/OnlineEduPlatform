@model OnlineEduPlatform.Models.Course

<h2>Създай нов курс</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Име на курса</label>
        <input asp-for="Name" class="form-control" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TeacherId" class="form-label">Учител</label>
        <select asp-for="TeacherId" class="form-select" required>
            <option value="">-- Избери учител --</option>
            @foreach (var teacher in ViewBag.Teachers as List<OnlineEduPlatform.Models.Teacher>)
            {
                <option value="@teacher.Id">@teacher.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>