@model IEnumerable<OnlineEduPlatform.Models.Course>

<h1>Всички курсове</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Създай нов курс</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Курс</th>
            <th>Учител</th>
            <th>Записани студенти</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr class="course-row" onclick="window.location='@Url.Action("Details", "Courses", new { id = course.Id })'" style="cursor: pointer;">
                <td>@course.Name</td>
                <td>@course.Teacher?.Name</td>
                <td>@course.Students.Count</td>
                <td class="delete-cell">
                    <form asp-action="Delete" asp-route-id="@course.Id" method="post"
                          onsubmit="return confirm('Сигурни ли сте, че искате да изтриете този курс?');"
                          onclick="event.stopPropagation();">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger delete-btn">Изтрий</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
